<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme; no user-visible text, so it stays here. All strings live in :ui-common.
         API 28-30 (compat) shows the static mark; values-v31 runs the animated one. -->
    <style name="Theme.Clavis.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/clavis_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>
